# OpenAI API Key (optional -- app works without it using rule-based fallback)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_api_key_here

# OpenAI model to use (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Ollama Configuration (optional -- for local LLM inference)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Token threshold for auto-routing (queries above this go to OpenAI)
TOKEN_THRESHOLD=1500

# Routing strategy: auto | always_ollama | always_openai
LLM_STRATEGY=auto
