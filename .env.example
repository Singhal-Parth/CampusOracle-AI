# Copy to .env. Never commit real credentials.
# Safe default: no provider calls, no API key needed.
LLM_STRATEGY=offline
# auto | offline | always_ollama | always_openai | always_gemini
# Cloud providers require BOTH this server opt-in and consent in the UI/request.
ALLOW_CLOUD_LLM=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
# Set a model available to your Google project before enabling Gemini.
GEMINI_MODEL=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
TOKEN_THRESHOLD=1500
# Optional API access token; required for non-loopback backend requests.
CAMPUS_API_TOKEN=
BACKEND_URL=http://127.0.0.1:8000
