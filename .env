# OpenAI API Key (optional)
OPENAI_API_KEY=

# Gemini API Key (optional)
GEMINI_API_KEY=AIzaSyCOUSWHx197GjyjV1I7XDkNMTUEswXHN7w

# OpenAI model to use (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Gemini model to use (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Ollama Configuration (optional -- for local LLM inference)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Token threshold for auto-routing (queries above this go to Gemini/OpenAI)
TOKEN_THRESHOLD=1500

# Routing strategy: auto | always_ollama | always_openai | always_gemini
LLM_STRATEGY=always_gemini
